{
  "name": "griddraft",
  "productName": "GridDraft",
  "description": "Desktop and command-line editor for directed network diagrams",
  "version": "0.2.0",
  "license": "MIT",
  "author": "GridDraft contributors",
  "main": "src/engine.cjs",
  "bin": { "griddraft": "./bin/griddraft.cjs" },
  "engines": { "node": ">=22" },
  "files": ["src/*.cjs", "bin", "schema", "examples", "docs", "README.md", "LICENSE", "THIRD_PARTY.md"],
  "scripts": {
    "start": "electron desktop.cjs",
    "test": "node --test test/*.test.cjs",
    "build:desktop": "electron-builder --win portable"
  },
  "dependencies": { "elkjs": "0.12.1" },
  "devDependencies": { "electron": "44.3.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "org.griddraft.desktop",
    "extraMetadata": { "main": "desktop.cjs" },
    "files": ["desktop.cjs", "preload.cjs", "src/**", "ui/**", "examples/**", "schema/**", "LICENSE", "THIRD_PARTY.md", "package.json"],
    "win": { "target": ["portable"], "signAndEditExecutable": false },
    "portable": { "artifactName": "GridDraft-Desktop-${version}-x64.exe", "unpackDirName": "griddraft-020" }
  }
}
